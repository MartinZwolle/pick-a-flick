# Copy to .env and supply your TMDb v3 API key.
# Never commit your populated .env file.
TMDB_API_KEY=
# Optional M12 cloud AI key; never exposed by the admin UI. Ollama needs no key.
PICKAFLICK_AI_API_KEY=

# Admin requires HTTPS by default. Only enable HTTP on a trusted home network.
PICKAFLICK_ADMIN_ALLOW_HTTP=false
# Optional M13: Fernet key for encrypting the Telegram bot token configured in admin.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key outside database backups; leave unset when Telegram is unused.
# PICKAFLICK_SECRET_KEY=
